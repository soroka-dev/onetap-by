{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onetap-by",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "vars": {
    "ALLOWED_ORIGIN": "https://onetap.by"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
